# Database (Supabase PostgreSQL with Transaction Pooler)

# Runtime app (Transaction Pooler - prevents prepared statement errors)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Prisma migrations / studio (Direct connection)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Node Environment
NODE_ENV="development"
